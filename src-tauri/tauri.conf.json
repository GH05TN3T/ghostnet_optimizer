{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostNet Optimizer",
  "version": "1.2.0",
  "identifier": "com.ghostnet.optimizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostNet Optimizer",
        "width": 1240,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 660,
        "theme": "Dark",
        "backgroundColor": "#0a0a0f",
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQzZEMzY5M0M4NTcxOUEKUldTYWNZVThhZFBHWUk0bU9QYUNKOVgvVHFRdERacFJ3RFdoQVZKOXIvckQ2Q0lYWTBMRWFxTVEK",
      "endpoints": [
        "https://github.com/GH05TN3T/ghostnet_optimizer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}