  {
    "id": "nagle",
    "name": "Desactivar algoritmo de Nagle",
    "desc": "Envía los paquetes TCP al instante en vez de agruparlos. Puede bajar el ping en juegos que usan TCP.",
    "category": "rendimiento",
    "recommended": false,
    "ps": {
      "check": "$any = $false; $ok = $true; foreach ($i in Get-ChildItem 'Registry::HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces') { $p = Get-ItemProperty -LiteralPath $i.PSPath; if ($p.DhcpIPAddress -or $p.IPAddress) { $any = $true; if ($p.TcpAckFrequency -ne 1 -or $p.TCPNoDelay -ne 1) { $ok = $false } } }; $any -and $ok",
      "apply": "foreach ($i in Get-ChildItem 'Registry::HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces') { $p = Get-ItemProperty -LiteralPath $i.PSPath; if ($p.DhcpIPAddress -or $p.IPAddress) { New-ItemProperty -LiteralPath $i.PSPath -Name TcpAckFrequency -Value 1 -PropertyType DWord -Force | Out-Null; New-ItemProperty -LiteralPath $i.PSPath -Name TCPNoDelay -Value 1 -PropertyType DWord -Force | Out-Null } }",
      "revert": "foreach ($i in Get-ChildItem 'Registry::HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces') { Remove-ItemProperty -LiteralPath $i.PSPath -Name TcpAckFrequency -ErrorAction SilentlyContinue; Remove-ItemProperty -LiteralPath $i.PSPath -Name TCPNoDelay -ErrorAction SilentlyContinue }"
    }
  },
