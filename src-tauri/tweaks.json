  {
    "id": "fast_startup",
    "name": "Desactivar Inicio rápido",
    "desc": "El apagado pasa a ser un apagado real. Evita problemas con drivers, actualizaciones y arranque dual. El arranque tarda unos segundos más.",
    "category": "sistema",
    "recommended": false,
    "reg": [
      { "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power", "name": "HiberbootEnabled", "value": 0, "default": 1 }
    ]
  },
  {
    "id": "hibernation",
    "name": "Desactivar hibernación",
    "desc": "Borra hiberfil.sys y libera varios GB (tanto como tu RAM). En portátiles perderás la opción Hibernar.",
    "category": "sistema",
    "recommended": false,
    "ps": {
      "check": "(Get-Reg 'Registry::HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Power' 'HibernateEnabled') -eq 0",
      "apply": "powercfg.exe /hibernate off",
      "revert": "powercfg.exe /hibernate on"
    }
  },
  {
    "id": "reserved_storage",
    "name": "Desactivar almacenamiento reservado",
    "desc": "Libera ~7 GB que Windows reserva para actualizaciones. Puede fallar si hay una actualización pendiente.",
    "category": "sistema",
    "recommended": false,
    "ps": {
      "check": "(Get-WindowsReservedStorageState).ReservedStorageState -eq 'Disabled'",
      "apply": "Set-WindowsReservedStorageState -State Disabled",
      "revert": "Set-WindowsReservedStorageState -State Enabled"
    }
  },
  {
    "id": "sysmain",
    "name": "Desactivar SysMain (Superfetch)",
    "desc": "Deja de precargar apps en RAM. Con SSD rara vez ayuda y reduce uso de disco y RAM. Con HDD mejor dejarlo.",
    "category": "sistema",
    "recommended": false,
    "svc": [
      { "name": "SysMain", "start": "Disabled", "default": "Automatic" }
    ]
  },
  {
