[
  {
    "id": "telemetry",
    "name": "Desactivar telemetría",
    "desc": "Pone la recolección de datos de diagnóstico al mínimo y desactiva los servicios DiagTrack y dmwappushservice.",
    "category": "privacidad",
    "recommended": true,
    "reg": [
      { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "value": 0 },
      { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\DataCollection", "name": "AllowTelemetry", "value": 0 }
    ],
    "svc": [
      { "name": "DiagTrack", "start": "Disabled", "default": "Automatic" },
      { "name": "dmwappushservice", "start": "Disabled", "default": "Manual" }
    ]
  },
  {
    "id": "telemetry_tasks",
    "name": "Desactivar tareas de telemetría",
    "desc": "Desactiva las tareas programadas del Programa de mejora de la experiencia (CEIP), el Compatibility Appraiser y el recolector de diagnóstico de disco.",
    "category": "privacidad",
    "recommended": true,
    "tasks": [
      { "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "Consolidator" },
      { "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "UsbCeip" },
      { "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "Microsoft Compatibility Appraiser" },
      { "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "ProgramDataUpdater" },
      { "path": "\\Microsoft\\Windows\\Autochk\\", "name": "Proxy" },
      { "path": "\\Microsoft\\Windows\\DiskDiagnostic\\", "name": "Microsoft-Windows-DiskDiagnosticDataCollector" }
    ]
  },
  {
    "id": "advertising_id",
    "name": "Desactivar ID de publicidad",
    "desc": "Evita que las apps usen tu ID de publicidad para mostrarte anuncios personalizados.",
    "category": "privacidad",
    "recommended": true,
    "reg": [
      { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "value": 0, "default": 1 },
      { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "value": 1 }
    ]
  },
  {
